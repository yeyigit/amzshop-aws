{
  "name": "amzshop-aws",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.890.0",
    "@aws-sdk/client-scheduler": "^3.890.0",
    "@aws-sdk/client-sns": "^3.890.0",
    "@aws-sdk/client-ssm": "^3.890.0",
    "@aws-sdk/lib-dynamodb": "^3.890.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.3.1",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
